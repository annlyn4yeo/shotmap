{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @shotmap/web build",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/matches", "destination": "/index.html" },
    { "source": "/match/:path*", "destination": "/index.html" },
    { "source": "/players/:path*", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
