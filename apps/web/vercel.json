{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/matches", "destination": "/index.html" },
    { "source": "/match/:path*", "destination": "/index.html" },
    { "source": "/players/:path*", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
