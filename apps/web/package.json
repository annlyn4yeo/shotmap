{
  "name": "shotmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "size": "pnpm build && node scripts/size.mjs",
    "lh": "node scripts/lh.mjs",
    "inp": "node scripts/inp.mjs",
    "fonts": "node scripts/fonts.mjs",
    "contrast": "node scripts/contrast.mjs",
    "data": "tsx scripts/build-data.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "25.16.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
