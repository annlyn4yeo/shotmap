{
  // The read-only /v1 API: Hono on a Worker, D1 for the data (docs/adr/0001, 0007).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shotmap-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",

  // `wrangler dev` runs this binding against a local D1 (load it with `pnpm --filter @shotmap/api load`).
  // The ids below are placeholders until `wrangler d1 create` has been run for each environment.
  "d1_databases": [
    { "binding": "DB", "database_name": "shotmap-dev", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],

  // The origin allowed to read the API from a browser when it is NOT served on the same origin
  // (the workers.dev fallback of decision Q2). Leave unset when /v1/* is routed on the web domain.
  "vars": { "WEB_ORIGIN": "" },

  "env": {
    "staging": {
      "name": "shotmap-api-staging",
      // vars are not inherited by an environment. The one origin allowed to read this API from a
      // browser: the Pages preview of the web app (a different origin from this Worker, so CORS).
      "vars": { "WEB_ORIGIN": "https://preview.shotmap.pages.dev" },
      "d1_databases": [
        { "binding": "DB", "database_name": "shotmap-staging", "database_id": "08d9f3ac-8ba7-414e-bbbf-7661f0634d97" },
        // The next release, loaded a part a day (the Free plan writes 100,000 rows a day, the kept
        // catalogue is 137,980: two parts): nothing reads it until it is complete and `DB` above is
        // pointed at it (docs/DEPLOY-API.md). The Worker does not use this binding; wrangler
        // needs it here to address the database by name. (shotmap-staging-next, 7c2cc659-55a9-4b3c-86c1-6bae83f1f98a,
        // held two of six parts of the whole source, abandoned when the catalogue was narrowed.)
        { "binding": "DB_NEXT", "database_name": "shotmap-staging-lite", "database_id": "b2bb7f65-d229-4845-87b7-ed378749b744" }
      ]
      // With a domain on Cloudflare (decision Q2, the default), route /v1/* on it so it is same-origin:
      // "routes": [{ "pattern": "staging.example.com/v1/*", "zone_name": "example.com" }]
    },
    "production": {
      "name": "shotmap-api",
      "d1_databases": [
        { "binding": "DB", "database_name": "shotmap", "database_id": "REPLACE_WITH_THE_ID_FROM_wrangler_d1_create" }
      ]
      // "routes": [{ "pattern": "example.com/v1/*", "zone_name": "example.com" }]
    }
  }
}
